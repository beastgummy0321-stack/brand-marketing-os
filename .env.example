DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 身分（票 03-1）——SUPABASE_URL 用來組 JWKS 網址（RS256/ES256 驗簽）與判斷是不是本機。
SUPABASE_URL=http://127.0.0.1:54321

# 本機開發用：Authorization: Bearer <這個值> 免登入，直接當種子開發使用者
# （00000000-0000-0000-0000-000000000001，org_dev 的 owner）。app.identity.register()
# 啟動時會檢查——這個變數只要一設，SUPABASE_URL 就必須是 localhost／127.0.0.1，否則
# 直接拒絕啟動（RuntimeError），避免正式環境不小心留著開發後門。正式環境留空。
IDENTITY_DEV_TOKEN=test-dev-token

# 本機開發用：允許用 SUPABASE_JWT_SECRET（HS256 共用密鑰）驗簽，不必真的跑一次 Supabase
# 登入流程就能手動 mint 測試用 token。設 1 才開放；正式環境（RS256/ES256 走 JWKS）不設。
# `supabase status` 的 JWT_SECRET 欄位就是這個值。
IDENTITY_ALLOW_HS256=1
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# 正式環境寄邀請信才需要（本機開發 SUPABASE_URL 是 localhost 時，/api/identity/invites
# 直接把連結放進 API 回應，不寄信）。
SUPABASE_SERVICE_ROLE_KEY=
