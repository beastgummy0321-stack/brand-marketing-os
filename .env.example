# 環境宣告（ADR 0062）——沒有設定＝production：app.core.config.settings() 開機驗一次，
# production／staging 底下 DATABASE_URL／SUPABASE_URL／SUPABASE_SERVICE_ROLE_KEY 必須明確
# 給、IDENTITY_DEV_TOKEN／IDENTITY_ALLOW_HS256／BRAND_OS_TODAY 一律禁止，設定錯誤直接拒絕
# 啟動（RuntimeError）。本機開發把下面這行取消註解；真正部署在自己的環境裡設定
# BRAND_OS_ENV，不要在這個會被複製到雲端的範本檔案裡打開它。
# BRAND_OS_ENV=local

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 身分（票 03-1）——SUPABASE_URL 用來組 JWKS 網址（RS256/ES256 驗簽）。
SUPABASE_URL=http://127.0.0.1:54321

# 本機開發用：Authorization: Bearer <這個值> 免登入，直接當種子開發使用者
# （00000000-0000-0000-0000-000000000001，org_dev 的 owner）。這是開發後門，只能在
# BRAND_OS_ENV=local 使用——app.core.config.settings() 開機時會檢查（ADR 0062），
# BRAND_OS_ENV 不是 local 時這個變數只要有值就直接拒絕啟動。正式環境留空。
IDENTITY_DEV_TOKEN=test-dev-token

# 本機開發用：允許用 SUPABASE_JWT_SECRET（HS256 共用密鑰）驗簽，不必真的跑一次 Supabase
# 登入流程就能手動 mint 測試用 token。設 1 才開放；正式環境（RS256/ES256 走 JWKS）不設。
# 這也是開發後門，只能在 BRAND_OS_ENV=local 使用，app.core.config.settings() 開機時會
# 檢查（ADR 0062）。本機開發把下面兩行取消註解，值填 `supabase status` 的 JWT_SECRET 欄位。
# IDENTITY_ALLOW_HS256=1
# SUPABASE_JWT_SECRET=

# 正式環境寄邀請信才需要（BRAND_OS_ENV=local 時，/api/identity/invites 直接把連結放進
# API 回應，不寄信）。
SUPABASE_SERVICE_ROLE_KEY=
